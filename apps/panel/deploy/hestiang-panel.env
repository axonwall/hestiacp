# HestiaCP (Next.js panel) — production environment.
#
# Installed to /usr/local/hestia/web-next/hestiang-panel.env and read
# by hestiang-panel.service (EnvironmentFile). Paths mirror the PHP
# panel exactly: the same bin directory, the same session directory
# (shared with FileGator and the web terminal, which authenticate off
# the PHP-format session files), and command execution through sudo
# under the existing hestiaweb sudoers rule.

NODE_ENV=production

# The Next.js standalone server binds locally; Hestia's nginx proxies
# :8083 to it (see nginx-vhost.conf).
HOSTNAME=127.0.0.1
# 8093, not 8084: the system nginx already holds 127.0.0.1:8084
# for its status stub (conf.d/status.conf) on a stock install —
# the panel crash-looped with EADDRINUSE on the first live box.
PORT=8093

HESTIA_BIN=/usr/local/hestia/bin
HESTIA_USE_SUDO=1
HESTIA_SESSION_DIR=/usr/local/hestia/data/sessions
# Session inactivity timeout in seconds (PHP default: 1800).
# HESTIA_SESSION_TIMEOUT=1800

# Background job records (WebApp installs). Directory must exist and
# be writable by hestiaweb; the cutover runbook creates it.
HESTIA_JOB_DIR=/usr/local/hestia/data/jobs

# php CLI used for password_hash in the Grav installer port.
# HESTIA_PHP_BIN=/usr/bin/php

# Where backup archives live (the download route streams local
# files from here under the PHP panel's access rule).
HESTIA_BACKUP_DIR=/backup
