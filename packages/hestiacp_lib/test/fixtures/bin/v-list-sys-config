#!/bin/bash
# Fixture: v-list-sys-config json. If HESTIA_FIXTURE_CONFIG points at a
# file, cat that instead (lets tests vary sys config, e.g. API disabled).
if [ -n "$HESTIA_FIXTURE_CONFIG" ] && [ -f "$HESTIA_FIXTURE_CONFIG" ]; then
	cat "$HESTIA_FIXTURE_CONFIG"
	exit 0
fi
cat << 'JSON'
{
