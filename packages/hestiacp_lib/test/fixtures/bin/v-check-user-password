#!/bin/bash
# Fixture: v-check-user-password USER SECRETFILE IP
# Mirrors the real command's contract: arg 2 may be a /tmp file whose first
# line is the secret. Fixture-only credential: user "admin", secret
# "spike-fixture-secret" (see apps/panel README). Not a real credential.
user="$1"
secret_arg="$2"
if [[ "$secret_arg" == /tmp/* && -f "$secret_arg" ]]; then
	secret_input=$(head -n 1 "$secret_arg")
else
	secret_input="$secret_arg"
fi
if { [ "$user" = "admin" ] || [ "$user" = "secure" ]; } && [ "$secret_input" = "spike-fixture-secret" ]; then
	exit 0
fi
echo "Error: password missmatch" >&2
exit 9
