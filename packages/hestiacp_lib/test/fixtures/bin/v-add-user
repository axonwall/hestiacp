#!/bin/bash
# Fixture: v-add-user USER PASSFILE EMAIL PACKAGE NAME — the secret must
# arrive as a readable staged file under /tmp, never as a literal.
echo "$(basename "$0") $*" >> "${HESTIA_FIXTURE_LOG:-/tmp/hestiang-fixture-calls.log}"
case "$2" in /tmp/*) [ -s "$2" ] || exit 9 ;; *) exit 9 ;; esac
exit 0
