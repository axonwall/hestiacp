#!/bin/bash
# Fixture: v-list-user USER json — one record keyed by username.
case "$1" in
admin)
	cat <<'JSON'
{
    "admin": {
        "NAME": "Administrator",
        "ROLE": "admin",
        "SHELL": "/bin/bash",
        "LANGUAGE": "en",
        "PACKAGE": "default",
        "CONTACT": "admin@example.com",
        "NS": "ns1.example.com,ns2.example.com",
        "LOGIN_DISABLED": "no",
        "THEME": "default",
        "WEB_DOMAINS": "1",
        "DNS_DOMAINS": "1",
        "MAIL_DOMAINS": "0",
        "DATABASES": "0",
        "CRON_JOBS": "2",
        "DISK_QUOTA": "unlimited",
        "SUSPENDED": "no"
    }
}
JSON
	;;
demo)
	cat <<'JSON'
{
    "demo": {
        "NAME": "Demo User",
        "ROLE": "user",
        "SHELL": "/bin/bash",
        "LANGUAGE": "en",
        "PACKAGE": "default",
        "CONTACT": "demo@example.com",
        "NS": "ns1.example.com,ns2.example.com",
        "LOGIN_DISABLED": "no",
        "THEME": "dark",
        "WEB_DOMAINS": "0",
        "DNS_DOMAINS": "0",
        "MAIL_DOMAINS": "0",
        "DATABASES": "1",
        "CRON_JOBS": "0",
        "DISK_QUOTA": "1024",
        "SUSPENDED": "no"
    }
}
JSON
	;;
secure)
	cat <<'JSON'
{
    "secure": {
        "NAME": "Secure User",
        "ROLE": "user",
        "SHELL": "/bin/bash",
        "LANGUAGE": "en",
        "PACKAGE": "default",
        "CONTACT": "secure@example.com",
        "NS": "ns1.example.com,ns2.example.com",
        "LOGIN_DISABLED": "no",
        "THEME": "default",
        "TWOFA": "FIXTUREBASE32SECRET",
        "QRCODE": "data:image/png;base64,fixtureqrcode",
        "WEB_DOMAINS": "0",
        "DNS_DOMAINS": "0",
        "MAIL_DOMAINS": "0",
        "DATABASES": "0",
        "CRON_JOBS": "0",
        "DISK_QUOTA": "1024",
        "SUSPENDED": "no"
    }
}
